{
  "$id": "https://scandal-season.example/schemas/scenes-season7.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Season Seven \u2014 'The Sins' scene container. Generated by tools/parse_season_seven.py from the Beth-signed-off chapter .md files.",
  "properties": {
    "_comment": {
      "description": "Optional human note; ignored by validation and importers.",
      "type": "string"
    },
    "scenes": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "ritual"
                }
              }
            },
            "then": {
              "required": [
                "ritual"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "gazette-sting"
                }
              }
            },
            "then": {
              "required": [
                "sting"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "fashion-selection"
                }
              }
            },
            "then": {
              "required": [
                "fashionChoices"
              ]
            }
          }
        ],
        "properties": {
          "animation": {
            "enum": [
              "Shared",
              "Custom"
            ],
            "type": "string"
          },
          "animationNote": {
            "description": "Bespoke reason for a Custom call, or a Shared staging note.",
            "type": "string"
          },
          "beatQualifier": {
            "description": "Optional qualifier from the scene header, e.g. 'villain' on plot beats.",
            "type": "string"
          },
          "chapter": {
            "maximum": 30,
            "minimum": 1,
            "type": "integer"
          },
          "chapterStatus": {
            "description": "FULL = signed-off build source; PILOT = format pilot, not yet locked.",
            "enum": [
              "FULL",
              "PILOT"
            ],
            "type": "string"
          },
          "chapterTitle": {
            "minLength": 1,
            "type": "string"
          },
          "fashionChoices": {
            "description": "Diegetic 2-3 option beats (no coin cost; the game remembers). May be empty for remembered-only beats.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "detail": {
                  "type": "string"
                },
                "label": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "label",
                "detail"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "id": {
            "pattern": "^[a-z0-9-]+$",
            "type": "string"
          },
          "keyDecision": {
            "additionalProperties": false,
            "properties": {
              "number": {
                "maximum": 3,
                "minimum": 1,
                "type": "integer"
              },
              "options": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "description": "Outcome/effects and dialogue of choosing this option. Choices may converge on the same outcome through different means; the game remembers the means.",
                      "type": "string"
                    },
                    "label": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "label",
                    "detail"
                  ],
                  "type": "object"
                },
                "minItems": 2,
                "type": "array"
              },
              "title": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "number",
              "title",
              "options"
            ],
            "type": "object"
          },
          "participants": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "playerTurns": {
            "description": "Authored player-turn count for this scene. Absent when the source states no count (never fabricated).",
            "minimum": 1,
            "type": "integer"
          },
          "prose": {
            "description": "The complete approved scene prose, verbatim (narrative, turns, dialogue).",
            "minLength": 1,
            "type": "string"
          },
          "ritual": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "directions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "occasionBrief": {
                "type": "string",
                "minLength": 1
              },
              "coinPerDecision": {
                "type": "integer",
                "minimum": 0
              },
              "coinTotal": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "directions"
            ],
            "description": "The dressing-ritual content: three A/B/C directions, occasion brief, pin economy."
          },
          "scene": {
            "description": "Scene number within the chapter (1-40).",
            "maximum": 40,
            "minimum": 1,
            "type": "integer"
          },
          "season": {
            "minimum": 1,
            "type": "integer"
          },
          "sourceFile": {
            "description": "Repo-relative path of the chapter .md this scene was parsed from.",
            "type": "string"
          },
          "sting": {
            "description": "Bell's Gazette sting text.",
            "minLength": 1,
            "type": "string"
          },
          "synopsis": {
            "description": "The scene's Purpose line from the chapter file.",
            "type": "string"
          },
          "turnNote": {
            "description": "How playerTurns was determined (e.g. declared count, counted markers).",
            "type": "string"
          },
          "type": {
            "enum": [
              "dialogue",
              "fashion-selection",
              "chapter-climax",
              "texture",
              "plot-beat",
              "gazette-sting",
              "cliffhanger",
              "ritual"
            ]
          }
        },
        "required": [
          "id",
          "season",
          "chapter",
          "scene",
          "chapterTitle",
          "chapterStatus",
          "type",
          "synopsis",
          "participants",
          "animation",
          "sourceFile"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": "2.1.0"
    },
    "season": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "season",
    "scenes"
  ],
  "title": "scenes-season7",
  "type": "object"
}