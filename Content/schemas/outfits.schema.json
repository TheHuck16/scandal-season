{"$id":"https://scandal-season.example/schemas/outfits.schema.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Reward outfits: dresses, hair, accessories, shoes, jewelry. Rewards are NEVER avatar unlocks. PLACEHOLDER content until design briefs land.","properties":{"_comment":{"type":"string","description":"Optional human note; ignored by validation and importers."},"outfits":{"items":{"additionalProperties":false,"properties":{"categories":{"description":"Scoring category ids this outfit is judged on (categories are visible; weights stay hidden).","items":{"minLength":1,"type":"string"},"type":"array"},"displayName":{"minLength":1,"type":"string"},"id":{"pattern":"^[a-z0-9-]+$","type":"string"},"pieces":{"items":{"additionalProperties":false,"properties":{"displayName":{"minLength":1,"type":"string"},"itemId":{"pattern":"^[a-z0-9-]+$","type":"string"},"slot":{"enum":["dress","hair","accessory","shoes","jewelry"],"type":"string"}},"required":["slot","itemId","displayName"],"type":"object"},"minItems":1,"type":"array"},"season":{"minimum":1,"type":"integer"},"specialEdition":{"default":false,"type":"boolean"}},"required":["id","displayName","season","pieces"],"type":"object"},"minItems":1,"type":"array"},"schemaVersion":{"const":"1.0.0","type":"string"}},"required":["schemaVersion","outfits"],"title":"Outfits","type":"object"}