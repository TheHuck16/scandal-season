{
  "$id": "https://scandal-season.example/schemas/scenes.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A season container: 30 chapters x 40 scenes (schema 2.1.0 covers Season One and Season Two): 30 chapters x 40 scenes. Generated by tools/parse_season_one.py / tools/parse_season_two.py from the Beth-signed-off chapter .md files (STATUS FULL / PILOT); prose lives in Content/story/*.md, this file carries the engine-readable structure. Scene taxonomy: dialogue, fashion-selection, chapter-climax (the one-per-chapter dressing ritual), texture, plot-beat, gazette-sting, cliffhanger. Key decisions are recorded with their options and remembered means; the game tracks tone/relationship/verdict flavor, never branch-tree plot state.",
  "properties": {
    "_comment": {
      "description": "Optional human note; ignored by validation and importers.",
      "type": "string"
    },
    "scenes": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "chapter-climax"
                }
              }
            },
            "then": {
              "required": [
                "ritual"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "gazette-sting"
                }
              }
            },
            "then": {
              "required": [
                "sting"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "fashion-selection"
                }
              }
            },
            "then": {
              "required": [
                "fashionChoices"
              ]
            }
          }
        ],
        "properties": {
          "animation": {
            "enum": [
              "Shared",
              "Custom"
            ],
            "type": "string"
          },
          "animationNote": {
            "description": "Bespoke reason for a Custom call, or a Shared staging note.",
            "type": "string"
          },
          "beatQualifier": {
            "description": "Optional qualifier from the scene header, e.g. 'villain' on plot beats.",
            "type": "string"
          },
          "chapter": {
            "maximum": 30,
            "minimum": 1,
            "type": "integer"
          },
          "chapterStatus": {
            "description": "FULL = signed-off build source; PILOT = format pilot, not yet locked.",
            "enum": [
              "FULL",
              "PILOT"
            ],
            "type": "string"
          },
          "chapterTitle": {
            "minLength": 1,
            "type": "string"
          },
          "fashionChoices": {
            "description": "Diegetic 2-3 option beats (no coin cost; the game remembers). May be empty for remembered-only beats.",
            "items": {
              "additionalProperties": false,
              "properties": {
                "detail": {
                  "type": "string"
                },
                "label": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "label",
                "detail"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "id": {
            "pattern": "^[a-z0-9-]+$",
            "type": "string"
          },
          "keyDecision": {
            "additionalProperties": false,
            "properties": {
              "number": {
                "maximum": 3,
                "minimum": 1,
                "type": "integer"
              },
              "options": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "description": "Outcome/effects and dialogue of choosing this option. Choices may converge on the same outcome through different means; the game remembers the means.",
                      "type": "string"
                    },
                    "label": {
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "label",
                    "detail"
                  ],
                  "type": "object"
                },
                "minItems": 2,
                "type": "array"
              },
              "title": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "number",
              "title",
              "options"
            ],
            "type": "object"
          },
          "participants": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "ritual": {
            "additionalProperties": false,
            "properties": {
              "coinPerDecision": {
                "minimum": 0,
                "type": "integer"
              },
              "coinTotal": {
                "minimum": 0,
                "type": "integer"
              },
              "directions": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "occasionBrief": {
                "description": "The published occasion brief Rose dresses to.",
                "minLength": 1,
                "type": "string"
              },
              "steps": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "stepsSummary": {
                "type": "string"
              },
              "part": {
                "type": "string",
                "description": "Part label within a multi-part ritual, e.g. \"Part II\". Absent for single-part rituals."
              }
            },
            "required": [],
            "type": "object",
            "description": "The dressing-ritual content for this part. In multi-part rituals the occasion brief/directions live on whichever part states them; every part carries its own pins."
          },
          "scene": {
            "description": "Scene number within the chapter (1-40).",
            "maximum": 40,
            "minimum": 1,
            "type": "integer"
          },
          "season": {
            "minimum": 1,
            "type": "integer"
          },
          "sourceFile": {
            "description": "Repo-relative path of the chapter .md this scene was parsed from.",
            "type": "string"
          },
          "sting": {
            "description": "Bell's Gazette sting text.",
            "minLength": 1,
            "type": "string"
          },
          "synopsis": {
            "description": "The scene's Purpose line from the chapter file.",
            "type": "string"
          },
          "type": {
            "enum": [
              "dialogue",
              "fashion-selection",
              "chapter-climax",
              "texture",
              "plot-beat",
              "gazette-sting",
              "cliffhanger"
            ]
          },
          "playerTurns": {
            "type": "integer",
            "minimum": 1,
            "description": "Authored player-turn count for this scene. Absent when the source states no count (never fabricated)."
          },
          "turnNote": {
            "type": "string",
            "description": "How playerTurns was determined (e.g. declared count, counted markers)."
          }
        },
        "required": [
          "id",
          "season",
          "chapter",
          "scene",
          "chapterTitle",
          "chapterStatus",
          "type",
          "synopsis",
          "participants",
          "animation",
          "sourceFile"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "const": "2.1.0"
    },
    "season": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schemaVersion",
    "season",
    "scenes"
  ],
  "title": "Scenes",
  "type": "object"
}